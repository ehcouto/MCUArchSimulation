%% File    : sfun_directlook.tlc
%% Abstract: 
%%      Level-2 S-function sfun_directlook block target file.
%%      It is using direct lookup algorithm without interpolation
%%
%% Copyright 1990-2010 The MathWorks, Inc.
%% $Revision: 1.1.6.1 $ 



%implements mci_set_digital "C"

%% Function: BlockTypeSetup ====================================================
%% Abstract:
%%     Place include and function prototype in the model's header file.
%%
%function BlockTypeSetup(block, system) void

%endfunction

%% Function: BlockInstanceSetup ===========================================
%%
%function BlockInstanceSetup(block, system) void
  %%

  %<LibBlockSetIsExpressionCompliant(block)>
  %assign header_file = "Mci.h"
  
  %<LibAddToCommonIncludes("%<header_file>")>
%endfunction

%% Function: Outputs ======================================================
%%
%function Outputs(block, system) Output
  %%
  %if IsModelReferenceSimTarget() || CodeFormat=="S-Function"
    
  %else 
    %if !LibBlockOutputSignalIsExpr(0)
      

      %assign write_data = SFcnParamSettings[0].write_data
      %assign u1_val = LibBlockInputSignal(0, "", "", 0)

      
      Mci__SetDigital(MOTOR0, %<write_data>, %<u1_val>);
      
    %endif 
  %endif 
  %%
%endfunction

%% Function: BlockOutputSignal ============================================
%%
%function BlockOutputSignal(block,system,portIdx,ucv,lcv,idx,retType) void
  %%
  %assign write_data = SFcnParamSettings[0].write_data
  %assign u1_val = LibBlockInputSignal(0, "", "", 0)
  %%
  %switch retType
    %case "Signal"
      %if portIdx == 0
        
        %return "Mci__SetDigital(MOTOR0, %<write_data>, %<u1_val>);"
        
      %else
        %assign errTxt = "Block output port index not supported: %<portIdx>"
        %<LibBlockReportError(block,errTxt)>
      %endif
    %default
      %assign errTxt = "Unsupported return type: %<retType>"
      %<LibBlockReportError(block,errTxt)>
  %endswitch
  %%
%endfunction

%% EOF: sfun_directlook.tlc
